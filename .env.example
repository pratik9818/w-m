# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# Postgres (Supabase) - async driver URL, e.g. postgresql+asyncpg://user:pass@host:5432/postgres
DATABASE_URL=

# Redis (Upstash) - TCP/TLS connection string, e.g. rediss://default:password@host:6379
REDIS_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Enquiry forms. A generated site posts its form to the `site-form` edge function, which
# lives in supabase/functions/site-form/ and is deployed into the same Supabase project.
# Leave this blank and the address is derived from SUPABASE_URL, which is what you want;
# set it only to point sites at a different deployment of that function.
#
# The function itself needs one secret set on the Supabase project, or enquiries are stored
# but the owner is never pinged when one arrives:
#     supabase secrets set TELEGRAM_BOT_TOKEN=<the same token as above>
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to edge functions automatically.)
# Deploy it with JWT verification OFF — a visitor's browser has no Supabase session, and
# requiring a key would only mean printing one into every page.
FORM_ENDPOINT_URL=

# Anthropic — the model behind everything the bot writes and reads (Claude Sonnet 5).
# Get a key at console.anthropic.com; the account needs credit on it.
ANTHROPIC_API_KEY=

# Pexels (stock photographs for generated sites — free key, instant, no billing, at
# https://www.pexels.com/api/new/ . 200 requests/hour and 20,000/month, far more than this
# uses. Leave blank and sites are simply built without photographs.)
PEXELS_API_KEY=

# Daytona (used for the Part 3 sandbox smoke test — get a key at app.daytona.io)
DAYTONA_API_KEY=

# Cloudflare Pages (used for the Part 4a live site hosting — get an API token at
# dash.cloudflare.com -> My Profile -> API Tokens -> "Cloudflare Pages" template, Edit,
# scoped to your account. Account ID is on any zone/account overview page.)
#
# The same token also reads visitor numbers, and the "Cloudflare Pages" template alone is
# NOT enough for that — it returns "Authentication error" on every analytics call. Edit the
# token and add two more account permissions:
#     Account -> Web Analytics    -> Edit   (creates the beacon for each new site)
#     Account -> Account Analytics -> Read  (reads the visitor numbers back)
# Without them everything still builds and deploys; sites simply never start counting, and
# the bot says so rather than reporting zero visitors.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Base domain for internal links back to the bot (not the generated sites, which get their own Vercel URLs)
BASE_DOMAIN=

# --- Payments (Razorpay) -----------------------------------------------------------
# Razorpay rather than Telegram Stars because Stars takes roughly a third of the price,
# and rather than Stripe because Stripe does not do domestic Indian recurring payments.
# Cashfree is the closest substitute and would need only bot_api/services/billing.py
# rewritten.
#
# Create the account at dashboard.razorpay.com, finish KYC (PAN, bank proof, business
# proof), then enable the *Subscriptions* product -- it is off by default and nothing
# below works without it.
#
# key_id is public and ships inside the payment page. key_secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# A third, separate value. In the dashboard: Settings -> Webhooks -> Add New Webhook,
# pointing at  https://<your PUBLIC_BASE_URL>/razorpay/webhook  and subscribed to:
#     subscription.activated   subscription.charged    subscription.pending
#     subscription.halted      subscription.cancelled  subscription.completed
# Razorpay shows you the secret once, when you create the webhook.
RAZORPAY_WEBHOOK_SECRET=
#
# One Razorpay Plan object per tier and billing period, created once under
# Subscriptions -> Plans. Amounts must match bot_api/services/plans.py:
#     Starter   ₹999/month     ₹9,990/year
#     Business  ₹1,999/month   ₹19,990/year
# They live here rather than being created from code because a Razorpay plan is immutable
# once it has subscribers -- generating them would mean a price change silently stranding
# everyone already paying the old one.
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=

# Where this app is reachable from a customer's browser, no trailing slash — the payment
# link sent into a chat is built from it. Must be https: Razorpay's checkout will not load
# on a plain http page.
PUBLIC_BASE_URL=

# The bot's own username, without the @. Used for the "Back to the chat" button on the
# payment page.
BOT_USERNAME=

# Origin of the standalone payment site in web/, if you deploy it -- e.g.
# https://pay.example.com, no trailing slash and no path.
#
# Set it and two things change: the payment link sent into a chat points there instead of
# at this app, and that origin becomes the only one a browser is allowed to call
# /api/checkout from. Leave it blank and the server-rendered pages under /pay/... are used
# instead, which needs no second deployment and no CORS at all.
#
# It must match the site's own web/config.js `apiBase` pointing back here, or every
# request fails as a CORS error with nothing useful in the logs. See web/README.md.
CHECKOUT_SITE_URL=
