# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# Postgres (Supabase) - async driver URL, e.g. postgresql+asyncpg://user:pass@host:5432/postgres
DATABASE_URL=

# Redis (Upstash) - TCP/TLS connection string, e.g. rediss://default:password@host:6379
REDIS_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Anthropic — the model behind everything the bot writes and reads (Claude Sonnet 5).
# Get a key at console.anthropic.com; the account needs credit on it.
ANTHROPIC_API_KEY=

# Pexels (stock photographs for generated sites — free key, instant, no billing, at
# https://www.pexels.com/api/new/ . 200 requests/hour and 20,000/month, far more than this
# uses. Leave blank and sites are simply built without photographs.)
PEXELS_API_KEY=

# Daytona (used for the Part 3 sandbox smoke test — get a key at app.daytona.io)
DAYTONA_API_KEY=

# Cloudflare Pages (used for the Part 4a live site hosting — get an API token at
# dash.cloudflare.com -> My Profile -> API Tokens -> "Cloudflare Pages" template, Edit,
# scoped to your account. Account ID is on any zone/account overview page.)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Base domain for internal links back to the bot (not the generated sites, which get their own Vercel URLs)
BASE_DOMAIN=
